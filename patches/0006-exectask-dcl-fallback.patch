Subject: ExecTask on OpenVMS: run a bare name that is no image as a DCL command

<exec executable="mms"> (a DCL verb) or a foreign command symbol could not
be started on OpenVMS: <exec> uses the VM launcher, and VSI's JVM starts
only image files ("Child mms creation error: no such file or directory");
build files had to say vmlauncher="false". Now, when the vmlauncher
attribute is not given, the executable is a bare name and the JVM found no
file of that name, the command is run again through the DCL launcher
(VmsCommandLauncher). A bare name the JVM can start (a JAVA$EXEC_MAPPING_nn
name, as ANT.EXE sets for java and javac) is unaffected. The property
ant.openvms.dclfallback=false turns it off. DECISIONS D5.

--- a/vmsport/src/ant/org/apache/tools/ant/taskdefs/ExecTask.java
+++ b/vmsport/src/ant/org/apache/tools/ant/taskdefs/ExecTask.java
@@ -77,6 +77,7 @@
      * command
      */
     private boolean vmLauncher = true;
+    private boolean vmLauncherSet = false;
 
 
     /**
@@ -611,6 +612,7 @@
      */
     public void setVMLauncher(boolean vmLauncher) {
         this.vmLauncher = vmLauncher;
+        this.vmLauncherSet = true;
     }
 
     /**
@@ -696,7 +698,17 @@
 
         exe.setCommandline(cmdl.getCommandline());
         try {
-            runExecute(exe);
+            try {
+                runExecute(exe);
+            } catch (IOException e) {
+                if (!dclFallback(e)) {
+                    throw e;
+                }
+                log("No image named " + cmdl.getExecutable()
+                    + ", running it as a DCL command", Project.MSG_VERBOSE);
+                exe.setVMLauncher(false);
+                runExecute(exe);
+            }
         } catch (IOException e) {
             if (failIfExecFails) {
                 throw new BuildException("Execute failed: " + e.toString(), e,
@@ -710,6 +722,28 @@
     }
 
     /**
+     * On OpenVMS, whether a command that could not be started as an image
+     * is to be run as a DCL command instead: when the vmlauncher attribute
+     * was not given, the executable is a bare name (a DCL verb such as MMS,
+     * or a foreign command symbol), and the JVM found no file of that name.
+     * The property ant.openvms.dclfallback=false turns this off.
+     */
+    private boolean dclFallback(IOException e) {
+        if (!Os.isFamily("openvms") || vmLauncherSet || !vmLauncher
+            || "false".equalsIgnoreCase(getProject().getProperty("ant.openvms.dclfallback"))) {
+            return false;
+        }
+        String exec = cmdl.getExecutable();
+        if (exec == null || exec.isEmpty() || exec.indexOf('/') >= 0
+            || exec.indexOf(':') >= 0 || exec.indexOf('[') >= 0
+            || exec.indexOf('<') >= 0) {
+            return false;
+        }
+        String msg = String.valueOf(e.getMessage()).toLowerCase(Locale.ROOT);
+        return msg.contains("no such file");
+    }
+
