+    /** The command that runs the script: through the runner, if there is one. */
+    private static String[] scriptCommand(File script) {
+        String runner = System.getProperty("ant.openvms.dclrunner");
+        if (runner != null && !runner.isEmpty() && new File(runner).exists()) {
+            return new String[] {runner, script.getPath()};
+        }
+        return new String[] {script.getPath()};
+    }
+
+    /** Quoted for DCL: in double quotes, with each double quote doubled. */
+    static String dclQuote(String s) {
+        return '"' + s.replace("\"", "\"\"") + '"';
+    }
+
+    /**
+     * An argument for the script: quoted if DCL would split it (white
+     * space) or end the line early (!); otherwise as it is, so that
+     * qualifiers stay qualifiers. One that has a double quote already is
+     * taken to be written for DCL (<arg value='"Two words"'/>) and is left
+     * as it is too. Empty becomes "".
+     */
+    static String dclArgument(String s) {
+        if (s.indexOf('"') >= 0) {
+            return s;
+        }
+        boolean quote = s.isEmpty();
+        for (int i = 0; i < s.length() && !quote; i++) {
+            char c = s.charAt(i);
+            quote = Character.isWhitespace(c) || c == '!';
+        }
+        return quote ? dclQuote(s) : s;
+    }
+
+    /**
+     * An absolute Unix path in OpenVMS form: /DEV/a/b/name.ext becomes
+     * DEV:[a.b]name.ext (and /DEV/name.ext DEV:[000000]name.ext), with the
+     * dots of directory names and all but the last dot of the file name
+     * escaped with ^, as ODS-5 needs.
+     */
+    static String vmsSpec(String path) {
+        String[] parts = path.substring(1).split("/");
+        if (parts.length < 2) {
+            return path;
+        }
+        StringBuilder sb = new StringBuilder(parts[0]).append(":[");
+        if (parts.length == 2) {
+            sb.append("000000");
+        }
+        for (int i = 1; i < parts.length - 1; i++) {
+            if (i > 1) {
+                sb.append('.');
+            }
+            sb.append(parts[i].replace(".", "^."));
+        }
+        sb.append(']');
+        String name = parts[parts.length - 1];
+        int dot = name.lastIndexOf('.');
+        if (dot > 0) {
+            sb.append(name.substring(0, dot).replace(".", "^."))
+                .append(name.substring(dot));
+        } else {
+            sb.append(name);
+        }
+        return sb.toString();
+    }
+
