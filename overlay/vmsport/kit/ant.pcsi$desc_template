--
-- PCSI product description for Apache Ant on OpenVMS.
-- Template: tools/prepare.sh substitutes @PRODUCER@, @BASE@ and @PCSIVERSION@, and
-- puts the Ant tree's directories and files in place of @TREE@ (tools/gen_kit.py).
-- [ANT] is the Ant home (ANT$ROOT:[000000]).  PCSI looks material up by
-- name in one flat directory, so each tree file has a material name of its own
-- (source [000000]Rnnnnn.DAT; MAKE_KIT.COM copies them there).  PCSI stores
-- names in upper case: ANT$STARTUP.COM INSTALL renames them back (ANT$CASE.COM).
--
product @PRODUCER@ @BASE@ ANT @PCSIVERSION@ full ;

    information RELEASE_NOTES phase after ;

    directory [ANT] ;
    file [SYS$STARTUP]ANT$STARTUP.COM ;
    file [ANT]ANT$SETUP.COM ;
    file [ANT]ANT$CASE.COM ;
    file [ANT]README.VMS ;

@TREE@

    -- Define ANT$ROOT, give the files their real names and print the
    -- post-installation tasks (PCSI shows only the title of an information
    -- message unless /HELP is given).
    execute postinstall "@PCSI$DESTINATION:[SYS$STARTUP]ANT$STARTUP.COM INSTALL" interactive ;
    -- On removal, deassign ANT$ROOT.
    execute install "CONTINUE" remove "@PCSI$DESTINATION:[SYS$STARTUP]ANT$STARTUP.COM REMOVE" ;

    information POST_INSTALL phase after ;

end product ;
